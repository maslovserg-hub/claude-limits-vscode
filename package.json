{
  "name": "claude-limits",
  "displayName": "AI Limits — Claude, Codex, Kimi",
  "description": "Monitor Claude Code, Codex and Kimi Code usage limits in separate VS Code status bar indicators.",
  "version": "0.3.4",
  "publisher": "maslovserg",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/maslovserg-hub/claude-limits-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "codex",
    "kimi",
    "kimi code",
    "moonshot",
    "usage",
    "limits",
    "rate limit",
    "status bar"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeLimits.refresh",
        "title": "AI Limits: Refresh"
      }
    ],
    "configuration": {
      "title": "AI Limits",
      "properties": {
        "claudeLimits.language": {
          "type": "string",
          "enum": [
            "ru",
            "en"
          ],
          "enumDescriptions": [
            "Russian: Сессия / Неделя",
            "English: Session / Week"
          ],
          "default": "en",
          "description": "Language for status bar labels"
        },
        "claudeLimits.claudeVisibility": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "hidden"
          ],
          "enumDescriptions": [
            "Show only when signed in to Claude",
            "Always show the Claude indicator",
            "Always hide the Claude indicator"
          ],
          "default": "auto",
          "description": "Controls Claude limits visibility"
        },
        "claudeLimits.codexVisibility": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "hidden"
          ],
          "enumDescriptions": [
            "Show only when signed in to Codex",
            "Always show the Codex indicator",
            "Always hide the Codex indicator"
          ],
          "default": "auto",
          "description": "Controls Codex limits visibility"
        },
        "claudeLimits.showProgressBars": {
          "type": "boolean",
          "default": true,
          "description": "Show progress bars for all services. Disable to save status bar space; percentages and reset times remain visible."
        },
        "claudeLimits.kimiVisibility": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "hidden"
          ],
          "enumDescriptions": [
            "Show only when signed in to Kimi Code",
            "Always show the Kimi indicator",
            "Always hide the Kimi indicator"
          ],
          "default": "auto",
          "description": "Controls Kimi limits visibility"
        },
        "claudeLimits.labels": {
          "type": "string",
          "enum": [
            "words",
            "letters"
          ],
          "enumDescriptions": [
            "Words: Session / Week / Month",
            "Letters: S / W / M (С / Н / М in Russian)"
          ],
          "default": "words",
          "description": "Window labels in the status bar"
        },
        "claudeLimits.showServiceNames": {
          "type": "boolean",
          "default": true,
          "description": "Show service names (Claude, Codex, Kimi) next to their logos"
        },
        "claudeLimits.shortWindowLabel": {
          "type": "string",
          "enum": [
            "session",
            "5h"
          ],
          "enumDescriptions": [
            "Session / Сессия (S / С in letters mode)",
            "5h / 5ч — the window is a rolling 5-hour limit that can span several sessions"
          ],
          "default": "session",
          "description": "Name of the 5-hour limit window"
        }
      }
    },
    "icons": {
      "claude-limits-claude": {
        "description": "Claude service logo",
        "default": {
          "fontPath": "./resources/service-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "claude-limits-codex": {
        "description": "Codex service logo",
        "default": {
          "fontPath": "./resources/service-icons.woff",
          "fontCharacter": "\\E002"
        }
      },
      "claude-limits-kimi": {
        "description": "Kimi service logo",
        "default": {
          "fontPath": "./resources/service-icons.woff",
          "fontCharacter": "\\E003"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
