{
  "name": "claude-limits",
  "displayName": "Claude & Codex Limits",
  "description": "Monitor Claude Code and Codex usage limits in separate VS Code status bar indicators.",
  "version": "0.3.4",
  "publisher": "maslovserg",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/maslovserg-hub/claude-limits-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeLimits.refresh",
        "title": "Claude & Codex Limits: Refresh"
      }
    ],
    "configuration": {
      "title": "Claude & Codex Limits",
      "properties": {
        "claudeLimits.language": {
          "type": "string",
          "enum": [
            "ru",
            "en"
          ],
          "enumDescriptions": [
            "Russian: Сессия / Неделя",
            "English: Session / Week"
          ],
          "default": "en",
          "description": "Language for status bar labels"
        },
        "claudeLimits.claudeVisibility": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "hidden"
          ],
          "enumDescriptions": [
            "Show only when signed in to Claude",
            "Always show the Claude indicator",
            "Always hide the Claude indicator"
          ],
          "default": "auto",
          "description": "Controls Claude limits visibility"
        },
        "claudeLimits.codexVisibility": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "hidden"
          ],
          "enumDescriptions": [
            "Show only when signed in to Codex",
            "Always show the Codex indicator",
            "Always hide the Codex indicator"
          ],
          "default": "auto",
          "description": "Controls Codex limits visibility"
        },
        "claudeLimits.showProgressBars": {
          "type": "boolean",
          "default": true,
          "description": "Show progress bars for Claude and Codex. Disable to save status bar space; percentages and reset times remain visible."
        }
      }
    },
    "icons": {
      "claude-limits-claude": {
        "description": "Claude service logo",
        "default": {
          "fontPath": "./resources/service-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "claude-limits-codex": {
        "description": "Codex service logo",
        "default": {
          "fontPath": "./resources/service-icons.woff",
          "fontCharacter": "\\E002"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
